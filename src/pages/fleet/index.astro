---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import { vessels } from '@/data/vessels';
import { getServiceById } from '@/data/services';
import { url } from '@/lib/site';
import { VESSEL_TYPE_LABELS } from '@/lib/labels';

/**
 * Fleet overview.
 *
 * The fleet register is the richest dataset the legacy site published: type,
 * class, IMO, MMSI, call sign, year and service assignment for all fourteen
 * vessels. It was buried in a hover menu, one vessel per menu item. Here it is
 * a sortable register plus a card for each ship.
 */
const sortedVessels = [...vessels].sort((a, b) => a.name.localeCompare(b.name));
const vesselTypes = [...new Set(vessels.map((v) => v.vesselType))];
---

<BaseLayout
  title="The fleet"
  description={`The ${vessels.length} vessels of the SDG Lines fleet, each named after a woman in science, medicine, mathematics, literature or education. Type, class, IMO number and service deployment for every ship.`}
>
  <PageHeader
    eyebrow="The fleet"
    title="Fourteen vessels, named after women who changed what we know"
    intro="Every ship in the fleet carries the name of a woman in science, medicine, mathematics, literature or education. The fleet list is also a reading list."
    tone="dark"
    breadcrumbs={[{ label: 'Fleet' }]}
  >
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={url('/fleet/spirit')}
        class="tap-target inline-flex items-center rounded-lg bg-white px-5 text-sm font-semibold text-navy-900 hover:bg-navy-100"
      >
        The spirit of the vessels
      </a>
      <a
        href="#register"
        class="tap-target inline-flex items-center rounded-lg border border-navy-500 px-5 text-sm font-semibold text-white hover:bg-navy-800"
      >
        Jump to the fleet register
      </a>
    </div>
  </PageHeader>

  <div class="shell py-12 lg:py-16">
    <!-- Fleet composition -->
    <section aria-labelledby="composition-heading">
      <h2 id="composition-heading" class="text-2xl">Fleet composition</h2>
      <dl class="mt-5 grid gap-3 sm:grid-cols-3">
        {
          vesselTypes.map((type) => {
            const count = vessels.filter((v) => v.vesselType === type).length;
            return (
              <div class="rounded-xl border border-navy-100 bg-white p-5">
                <dt class="text-sm font-medium text-navy-600">{VESSEL_TYPE_LABELS[type]}</dt>
                <dd class="mt-1 font-display text-3xl font-semibold text-navy-900">{count}</dd>
              </div>
            );
          })
        }
      </dl>
    </section>

    <!-- Vessel cards -->
    <section aria-labelledby="vessels-heading" class="mt-14">
      <h2 id="vessels-heading" class="text-2xl">The vessels</h2>

      <ul class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {
          sortedVessels.map((vessel) => {
            const service = vessel.serviceId ? getServiceById(vessel.serviceId) : null;
            return (
              <li>
                <a
                  href={url(`/fleet/${vessel.slug}`)}
                  class="group flex h-full flex-col rounded-xl border border-navy-100 bg-white p-6 transition-all duration-(--duration-base) hover:-translate-y-0.5 hover:border-sea-300 hover:shadow-lg hover:shadow-navy-900/5"
                >
                  <div class="flex items-center gap-2">
                    {service ? (
                      <span
                        class="h-1.5 w-8 rounded-full"
                        style={`background-color:${service.mapColor}`}
                        aria-hidden="true"
                      />
                    ) : (
                      <span class="h-1.5 w-8 rounded-full bg-navy-200" aria-hidden="true" />
                    )}
                    <span class="font-mono text-[0.6875rem] uppercase tracking-wider text-navy-500">
                      {vessel.vesselType}
                    </span>
                  </div>

                  <h3 class="mt-3 font-display text-lg font-semibold text-navy-900 group-hover:text-sea-700">
                    {vessel.name}
                  </h3>

                  <p class="mt-1 text-sm text-navy-600">
                    {vessel.namesake.field}, {vessel.namesake.lifespan}
                  </p>

                  <dl class="mt-5 space-y-1.5 border-t border-navy-100 pt-4 text-xs">
                    <div class="flex justify-between gap-3">
                      <dt class="text-navy-500">IMO</dt>
                      <dd class="font-mono text-navy-800">{vessel.imo}</dd>
                    </div>
                    <div class="flex justify-between gap-3">
                      <dt class="text-navy-500">Call sign</dt>
                      <dd class="font-mono text-navy-800">{vessel.callSign}</dd>
                    </div>
                    <div class="flex justify-between gap-3">
                      <dt class="text-navy-500">Service</dt>
                      <dd class="font-medium text-navy-800">
                        {service ? service.name : 'Pilot vessel'}
                      </dd>
                    </div>
                  </dl>
                </a>
              </li>
            );
          })
        }
      </ul>
    </section>

    <!-- Register -->
    <section aria-labelledby="register-heading" class="mt-14 scroll-mt-28" id="register">
      <h2 id="register-heading" class="text-2xl">Fleet register</h2>
      <p class="mt-2 max-w-2xl text-navy-600">
        The complete register as published in the fleet table. Identifiers are part of the
        simulation.
      </p>

      <div class="mt-5 overflow-x-auto rounded-xl border border-navy-100">
        <table class="w-full min-w-[46rem] text-left text-sm">
          <caption class="sr-only">
            SDG Lines fleet register: vessel, type, class, IMO number, MMSI, call sign, year
            launched and service
          </caption>
          <thead class="bg-navy-50 text-xs uppercase tracking-wide text-navy-600">
            <tr>
              <th scope="col" class="px-4 py-3 font-semibold">Vessel</th>
              <th scope="col" class="px-4 py-3 font-semibold">Type</th>
              <th scope="col" class="px-4 py-3 font-semibold">Class</th>
              <th scope="col" class="px-4 py-3 font-semibold">IMO</th>
              <th scope="col" class="px-4 py-3 font-semibold">MMSI</th>
              <th scope="col" class="px-4 py-3 font-semibold">Call sign</th>
              <th scope="col" class="px-4 py-3 font-semibold">Launched</th>
              <th scope="col" class="px-4 py-3 font-semibold">Service</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-navy-100">
            {
              sortedVessels.map((vessel) => {
                const service = vessel.serviceId ? getServiceById(vessel.serviceId) : null;
                return (
                  <tr class="transition-colors duration-(--duration-fast) hover:bg-navy-50/60">
                    <th scope="row" class="px-4 py-3 font-medium">
                      <a
                        href={url(`/fleet/${vessel.slug}`)}
                        class="text-navy-900 underline decoration-navy-200 underline-offset-4 hover:text-sea-700 hover:decoration-sea-600"
                      >
                        {vessel.name}
                      </a>
                    </th>
                    <td class="px-4 py-3 text-navy-700">{vessel.vesselType}</td>
                    <td class="px-4 py-3 text-navy-700">{vessel.className}</td>
                    <td class="px-4 py-3 font-mono text-xs text-navy-700">{vessel.imo}</td>
                    <td class="px-4 py-3 font-mono text-xs text-navy-700">{vessel.mmsi}</td>
                    <td class="px-4 py-3 font-mono text-xs text-navy-700">{vessel.callSign}</td>
                    <td class="px-4 py-3 text-navy-700">{vessel.yearLaunched}</td>
                    <td class="px-4 py-3">
                      {service ? (
                        <a
                          href={url(`/routes/${service.slug}`)}
                          class="text-sea-700 underline underline-offset-4 hover:text-sea-800"
                        >
                          {service.name}
                        </a>
                      ) : (
                        <span class="text-navy-500">Pilot</span>
                      )}
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
    </section>
  </div>
</BaseLayout>
