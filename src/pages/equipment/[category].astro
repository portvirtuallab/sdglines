---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import EquipmentTable from '@/components/ui/EquipmentTable.astro';
import ReviewNotice from '@/components/ui/ReviewNotice.astro';
import { equipment } from '@/data/equipment';
import { url } from '@/lib/site';
import { formatMetres, formatNumber } from '@/lib/labels';
import { families } from '@/data/equipmentFamilies';

/**
 * One page per equipment family.
 *
 * The families do not map one to one onto the model categories: open top units
 * are containers as far as a learner is concerned, so they are shown on the
 * containers page rather than given a page of their own.
 */
export function getStaticPaths() {
  return families.map((family) => ({
    params: { category: family.slug },
    props: { family },
  }));
}

const { family } = Astro.props;
const items = equipment.filter((item) => family.categories.includes(item.category));
const otherFamilies = families.filter((other) => other.slug !== family.slug);
---

<BaseLayout
  title={family.title}
  description={`${family.intro} Internal dimensions, tare weight, maximum payload and capacity for each unit used by SDG Lines.`}
>
  <PageHeader
    eyebrow={family.eyebrow}
    title={family.title}
    intro={family.intro}
    breadcrumbs={[{ label: 'Equipment', href: '/equipment' }, { label: family.title }]}
  />

  <div class="shell py-12 lg:py-16">
    <div class="grid gap-12 lg:grid-cols-[1.6fr_1fr] lg:gap-14">
      <div class="min-w-0">
        <section aria-labelledby="specs-heading">
          <h2 id="specs-heading" class="text-2xl">Specifications</h2>
          <div class="mt-5">
            <EquipmentTable items={items} caption={`Specifications for ${family.title}`} />
          </div>

          {
            items.some((item) => item.meta.status !== 'verified') && (
              <div class="mt-4 space-y-3">
                {items
                  .filter((item) => item.meta.status !== 'verified')
                  .map((item) => (
                    <ReviewNotice meta={item.meta} subject={`The ${item.name} record`} />
                  ))}
              </div>
            )
          }
        </section>

        <section aria-labelledby="units-heading" class="mt-12">
          <h2 id="units-heading" class="text-2xl">The units</h2>
          <div class="mt-5 space-y-4">
            {
              items.map((item) => (
                <article class="rounded-xl border border-navy-100 bg-white p-6">
                  <div class="flex flex-wrap items-start justify-between gap-3">
                    <h3 class="font-display text-lg font-semibold text-navy-900">{item.name}</h3>
                    {item.isoCode && (
                      <span class="rounded bg-navy-50 px-2 py-0.5 font-mono text-xs text-navy-600">
                        ISO {item.isoCode}
                      </span>
                    )}
                  </div>

                  <p class="mt-2 leading-relaxed text-navy-700">{item.summary}</p>

                  <h4 class="mt-5 text-xs font-semibold uppercase tracking-wide text-navy-500">
                    Typically used for
                  </h4>
                  <ul class="mt-2 space-y-1 text-sm text-navy-700">
                    {item.typicalUse.map((use) => (
                      <li class="flex gap-2">
                        <span class="text-sea-600" aria-hidden="true">
                          &bull;
                        </span>
                        {use}
                      </li>
                    ))}
                  </ul>

                  <dl class="mt-5 grid grid-cols-2 gap-3 border-t border-navy-100 pt-4 text-sm sm:grid-cols-4">
                    <div>
                      <dt class="text-xs uppercase tracking-wide text-navy-500">Internal length</dt>
                      <dd class="mt-0.5 font-mono text-navy-900">
                        {formatMetres(item.dimensions.internalLengthM)}
                      </dd>
                    </div>
                    <div>
                      <dt class="text-xs uppercase tracking-wide text-navy-500">Internal height</dt>
                      <dd class="mt-0.5 font-mono text-navy-900">
                        {formatMetres(item.dimensions.internalHeightM)}
                      </dd>
                    </div>
                    <div>
                      <dt class="text-xs uppercase tracking-wide text-navy-500">Tare</dt>
                      <dd class="mt-0.5 font-mono text-navy-900">
                        {formatNumber(item.dimensions.tareKg, 'kg')}
                      </dd>
                    </div>
                    <div>
                      <dt class="text-xs uppercase tracking-wide text-navy-500">Max payload</dt>
                      <dd class="mt-0.5 font-mono text-navy-900">
                        {formatNumber(item.dimensions.maxPayloadKg, 'kg')}
                      </dd>
                    </div>
                  </dl>
                </article>
              ))
            }
          </div>
        </section>

        <section aria-labelledby="guidance-heading" class="mt-12">
          <h2 id="guidance-heading" class="text-2xl">What to watch for</h2>
          <div class="mt-5 space-y-4">
            {
              family.guidance.map((note) => (
                <div class="rounded-xl border border-navy-100 bg-navy-50/50 p-5">
                  <h3 class="font-display text-base font-semibold text-navy-900">{note.heading}</h3>
                  <p class="mt-2 leading-relaxed text-navy-700">{note.body}</p>
                </div>
              ))
            }
          </div>
        </section>
      </div>

      <aside class="space-y-6 lg:sticky lg:top-28 lg:self-start">
        <div class="rounded-2xl border border-navy-100 p-6">
          <h2 class="font-display text-base font-semibold text-navy-900">Other equipment</h2>
          <ul class="mt-3 space-y-1">
            {
              otherFamilies.map((other) => (
                <li>
                  <a
                    href={url(`/equipment/${other.slug}`)}
                    class="flex min-h-9 items-center text-sm text-navy-700 hover:text-sea-700 hover:underline underline-offset-4"
                  >
                    {other.title}
                  </a>
                </li>
              ))
            }
            <li>
              <a
                href={url('/equipment/packing')}
                class="flex min-h-9 items-center text-sm text-navy-700 hover:text-sea-700 hover:underline underline-offset-4"
              >
                Packing guidance
              </a>
            </li>
          </ul>
        </div>

        <div class="rounded-2xl border border-navy-100 bg-navy-50/60 p-6">
          <h2 class="font-display text-base font-semibold text-navy-900">Use this equipment</h2>
          <a
            href={url('/request-a-quote')}
            class="tap-target mt-4 flex w-full items-center justify-center rounded-lg bg-signal-500 px-4 text-sm font-semibold text-navy-950 hover:bg-signal-400"
          >
            Request a quotation
          </a>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
