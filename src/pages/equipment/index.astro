---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import EquipmentTable from '@/components/ui/EquipmentTable.astro';
import { equipment } from '@/data/equipment';
import { url } from '@/lib/site';

/**
 * Equipment catalogue.
 *
 * One page that answers "what fits in what", because that question is asked at
 * the point of choosing equipment for a quotation and splitting it across five
 * pages makes comparison impossible. The category pages exist for depth; this
 * page exists for the comparison.
 */
const groups = [
  {
    slug: 'containers',
    heading: 'Containers',
    intro:
      'Closed steel boxes for general cargo. The choice between them comes down to whether the cargo runs out of weight or runs out of space first.',
    items: equipment.filter(
      (item) => item.category === 'container' || item.category === 'open-top',
    ),
  },
  {
    slug: 'reefers',
    heading: 'Reefers',
    intro:
      'Insulated units with their own refrigeration machinery. The machinery costs internal length, so a reefer always holds less than the dry box of the same nominal size.',
    items: equipment.filter((item) => item.category === 'reefer'),
  },
  {
    slug: 'flat-racks',
    heading: 'Flat racks',
    intro:
      'Container floors with end walls and no sides, for cargo that will not fit inside a closed unit.',
    items: equipment.filter((item) => item.category === 'flat-rack'),
  },
  {
    slug: 'roll-trailers',
    heading: 'Roll trailers',
    intro:
      'Platforms towed on and off the vessel by terminal tractors. They never leave the port: cargo is loaded onto them at the terminal.',
    items: equipment.filter((item) => item.category === 'roll-trailer'),
  },
];
---

<BaseLayout
  title="Equipment"
  description="Containers, reefers, flat racks and roll trailers used by SDG Lines, with internal dimensions, tare weight, maximum payload and capacity for each unit."
>
  <PageHeader
    eyebrow="Cargo"
    title="Equipment"
    intro="Every unit SDG Lines carries, with the internal dimensions, tare weight and payload you need to decide whether a cargo fits."
    breadcrumbs={[{ label: 'Equipment' }]}
  />

  <div class="shell py-12 lg:py-16">
    <!-- Comparison across everything -->
    <section aria-labelledby="comparison-heading">
      <h2 id="comparison-heading" class="text-2xl">All units compared</h2>
      <p class="mt-2 max-w-2xl text-navy-600">
        Internal dimensions are given first, because that is the measurement that decides whether
        the cargo fits. Tare plus payload gives the maximum gross weight of the unit.
      </p>
      <div class="mt-5">
        <EquipmentTable
          items={equipment}
          caption="All SDG Lines equipment with ISO code, internal dimensions, tare weight, maximum payload and capacity"
        />
      </div>
      <p class="mt-3 text-xs leading-relaxed text-navy-500">
        Container figures are the nominal ISO values used across the industry. Individual units vary
        by builder and by age, so an exercise that turns on a few centimetres should use the data
        plate on the actual unit. Roll trailers are not standardised and their figures are typical
        rather than specified.
      </p>
    </section>

    <!-- By category -->
    <div class="mt-16 space-y-14">
      {
        groups.map((group) => (
          <section aria-labelledby={`${group.slug}-heading`}>
            <div class="flex flex-wrap items-end justify-between gap-4">
              <div class="max-w-2xl">
                <h2 id={`${group.slug}-heading`} class="text-2xl">
                  {group.heading}
                </h2>
                <p class="mt-2 text-navy-600">{group.intro}</p>
              </div>
              <a
                href={url(`/equipment/${group.slug}`)}
                class="tap-target inline-flex items-center rounded-lg border border-navy-200 px-4 text-sm font-semibold text-navy-800 hover:bg-navy-50"
              >
                {group.heading} in detail &rarr;
              </a>
            </div>

            <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {group.items.map((item) => (
                <li class="flex h-full flex-col rounded-xl border border-navy-100 bg-white p-5">
                  <div class="flex items-start justify-between gap-3">
                    <h3 class="font-display text-base font-semibold text-navy-900">{item.name}</h3>
                    {item.isoCode && (
                      <span class="shrink-0 rounded bg-navy-50 px-1.5 py-0.5 font-mono text-[0.6875rem] text-navy-500">
                        {item.isoCode}
                      </span>
                    )}
                  </div>
                  <p class="mt-2 text-sm leading-relaxed text-navy-600">{item.summary}</p>
                  <ul class="mt-4 space-y-1 border-t border-navy-100 pt-3 text-xs text-navy-600">
                    {item.typicalUse.map((use) => (
                      <li class="flex gap-2">
                        <span class="text-navy-400" aria-hidden="true">
                          &bull;
                        </span>
                        {use}
                      </li>
                    ))}
                  </ul>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <!-- Next steps -->
    <section class="mt-16 rounded-2xl border border-navy-100 bg-navy-50/60 p-7">
      <h2 class="text-xl">Chosen your equipment?</h2>
      <p class="mt-2 max-w-2xl text-navy-600">
        Take the unit into a quotation, or read how to pack and secure it before it leaves the
        warehouse.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a
          href={url('/quote')}
          class="tap-target inline-flex items-center rounded-lg bg-signal-600 px-5 text-sm font-semibold text-white hover:bg-signal-700"
        >
          Request a quotation
        </a>
        <a
          href={url('/equipment/packing')}
          class="tap-target inline-flex items-center rounded-lg border border-navy-200 bg-white px-5 text-sm font-semibold text-navy-800 hover:bg-white/60"
        >
          Packing guidance
        </a>
        <a
          href={url('/services/dangerous-goods')}
          class="tap-target inline-flex items-center rounded-lg border border-navy-200 bg-white px-5 text-sm font-semibold text-navy-800 hover:bg-white/60"
        >
          Dangerous goods
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
