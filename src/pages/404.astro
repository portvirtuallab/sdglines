---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { url } from '@/lib/site';

/**
 * Not found.
 *
 * The legacy site had a number of broken addresses, including two ports whose
 * links were malformed and an Arrival Charges link that redirected to the home
 * page. Anyone following an old link or an old bookmark lands here, so this page
 * is built to send them onwards rather than to apologise.
 *
 * `redirects.ts` maps the known legacy addresses to their new homes; this page
 * is the fallback for everything else.
 */
const destinations = [
  { label: 'Routes', href: '/routes', description: 'The five services and their rotations' },
  { label: 'Port directory', href: '/ports', description: 'All 36 ports of call' },
  { label: 'The fleet', href: '/fleet', description: 'Fourteen vessels and their register' },
  {
    label: 'Equipment',
    href: '/equipment',
    description: 'Containers, reefers, racks and trailers',
  },
  {
    label: 'Arrival charges',
    href: '/resources/arrival-charges',
    description: 'Local charges explained',
  },
  { label: 'Request a quotation', href: '/request-a-quote', description: 'Build a simulated quotation' },
];
---

<BaseLayout
  title="Page not found"
  description="This page does not exist on the SDG Lines website. Search the site or start from the routes, ports, fleet or equipment sections."
  noindex
>
  <div class="shell py-16 lg:py-24">
    <div class="max-w-2xl">
      <p class="font-mono text-sm font-medium uppercase tracking-[0.18em] text-sea-700">
        Error 404
      </p>
      <h1 class="mt-4 text-4xl sm:text-5xl">This page is not on the chart</h1>
      <p class="mt-5 text-lg leading-relaxed text-navy-600">
        The address you followed does not exist on this site. The website was rebuilt in 2026 and a
        number of pages moved, so an older link or bookmark may no longer resolve.
      </p>

      <form action={url('/search')} method="get" class="mt-8">
        <label for="notfound-search" class="block text-sm font-medium text-navy-900">
          Search for what you were looking for
        </label>
        <div class="mt-1.5 flex gap-2">
          <input
            id="notfound-search"
            name="q"
            type="search"
            autocomplete="off"
            placeholder="Port, route, vessel, container type..."
            class="tap-target w-full rounded-lg border border-navy-200 bg-white px-4 text-base text-navy-900 placeholder:text-navy-500 focus:border-sea-600"
          />
          <button
            type="submit"
            class="tap-target shrink-0 rounded-lg bg-navy-900 px-5 text-sm font-semibold text-white hover:bg-navy-800"
          >
            Search
          </button>
        </div>
      </form>
    </div>

    <section aria-labelledby="destinations-heading" class="mt-14">
      <h2 id="destinations-heading" class="text-xl">Or start from one of these</h2>
      <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          destinations.map((destination) => (
            <li>
              <a
                href={url(destination.href)}
                class="group flex h-full flex-col rounded-xl border border-navy-100 bg-white p-5 transition-all duration-(--duration-base) hover:border-sea-300 hover:shadow-md"
              >
                <span class="font-display text-base font-semibold text-navy-900 group-hover:text-sea-700">
                  {destination.label}
                </span>
                <span class="mt-1 text-sm text-navy-600">{destination.description}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
