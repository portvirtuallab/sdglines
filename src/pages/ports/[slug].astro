---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import ReviewNotice from '@/components/ui/ReviewNotice.astro';
import SimulationNotice from '@/components/layout/SimulationNotice.astro';
import { ports, getPortById } from '@/data/ports';
import { getServiceById } from '@/data/services';
import { url } from '@/lib/site';
import {
  CAPABILITY_DESCRIPTIONS,
  CAPABILITY_LABELS,
  formatNumber,
  TO_BE_CONFIRMED,
} from '@/lib/labels';

/** One page per port of call. */
export function getStaticPaths() {
  return ports.map((port) => ({
    params: { slug: port.slug },
    props: { port },
  }));
}

const { port } = Astro.props;

const callingServices = port.serviceIds
  .map((id) => getServiceById(id))
  .filter((service): service is NonNullable<typeof service> => Boolean(service));

/** Ports reached directly before or after this one on any service. */
const connectedPorts = new Map<string, { name: string; slug: string; via: string[] }>();
for (const service of callingServices) {
  const index = service.rotation.findIndex((call) => call.portId === port.id);
  for (const offset of [-1, 1]) {
    const neighbour = service.rotation[index + offset];
    if (!neighbour) continue;
    const neighbourPort = getPortById(neighbour.portId);
    if (!neighbourPort) continue;
    const existing = connectedPorts.get(neighbourPort.id);
    if (existing) {
      if (!existing.via.includes(service.name)) existing.via.push(service.name);
    } else {
      connectedPorts.set(neighbourPort.id, {
        name: neighbourPort.displayName,
        slug: neighbourPort.slug,
        via: [service.name],
      });
    }
  }
}

const [latitude, longitude] = port.coordinates;

/** Degrees and decimal minutes, the notation used on nautical charts. */
function formatCoordinate(value: number, positive: string, negative: string): string {
  const hemisphere = value >= 0 ? positive : negative;
  const absolute = Math.abs(value);
  const degrees = Math.floor(absolute);
  const minutes = (absolute - degrees) * 60;
  return `${degrees}° ${minutes.toFixed(1)}' ${hemisphere}`;
}

const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Place',
  name: port.displayName,
  description: port.summary,
  address: { '@type': 'PostalAddress', addressCountry: port.countryCode },
  geo: { '@type': 'GeoCoordinates', latitude, longitude },
  additionalProperty: {
    '@type': 'PropertyValue',
    name: 'Educational simulation',
    value:
      'This port page is part of an educational simulation and does not describe a commercial service.',
  },
});
---

<BaseLayout
  title={port.displayName}
  description={`${port.displayName}, ${port.country}. ${port.summary} Served by ${callingServices.map((s) => s.name).join(', ')}.`}
  structuredData={structuredData}
>
  <PageHeader
    eyebrow={`${port.country} · ${port.region}`}
    title={port.displayName}
    intro={port.summary}
    breadcrumbs={[{ label: 'Ports', href: '/ports' }, { label: port.name }]}
  />

  <div class="shell py-12 lg:py-16">
    <div class="grid gap-12 lg:grid-cols-[1.6fr_1fr] lg:gap-14">
      <div class="min-w-0">
        <!-- Port particulars -->
        <section aria-labelledby="particulars-heading">
          <h2 id="particulars-heading" class="text-2xl">Port details</h2>

          <dl
            class="mt-5 grid gap-px overflow-hidden rounded-xl border border-navy-100 bg-navy-100 sm:grid-cols-2"
          >
            <div class="bg-white px-5 py-4">
              <dt class="text-xs uppercase tracking-wide text-navy-500">Country</dt>
              <dd class="mt-1 font-medium text-navy-900">{port.country}</dd>
            </div>
            <div class="bg-white px-5 py-4">
              <dt class="text-xs uppercase tracking-wide text-navy-500">Region</dt>
              <dd class="mt-1 font-medium text-navy-900">{port.region}</dd>
            </div>
            <div class="bg-white px-5 py-4">
              <dt class="text-xs uppercase tracking-wide text-navy-500">UN/LOCODE</dt>
              <dd class="mt-1 font-mono font-medium text-navy-900">
                {port.locode ?? TO_BE_CONFIRMED}
              </dd>
            </div>
            <div class="bg-white px-5 py-4">
              <dt class="text-xs uppercase tracking-wide text-navy-500">Position</dt>
              <dd class="mt-1 font-mono text-sm font-medium text-navy-900">
                {formatCoordinate(latitude, 'N', 'S')}
                {formatCoordinate(longitude, 'E', 'W')}
              </dd>
            </div>
            <div class="bg-white px-5 py-4 sm:col-span-2">
              <dt class="text-xs uppercase tracking-wide text-navy-500">
                Annual container throughput
              </dt>
              <dd class="mt-1 font-medium text-navy-900">
                {
                  port.annualThroughputTeu
                    ? `${formatNumber(port.annualThroughputTeu)} TEU`
                    : TO_BE_CONFIRMED
                }
              </dd>
            </div>
          </dl>

          <ReviewNotice meta={port.meta} subject="This port record" class="mt-4" />
        </section>

        <!-- Services -->
        <section aria-labelledby="services-heading" class="mt-12">
          <h2 id="services-heading" class="text-2xl">Services calling here</h2>
          <p class="mt-2 text-navy-600">
            {
              callingServices.length === 1
                ? 'One service calls at this port.'
                : `${callingServices.length} services call at this port.`
            }
          </p>

          <ul class="mt-5 space-y-3">
            {
              callingServices.map((service) => {
                const position = service.rotation.findIndex((call) => call.portId === port.id) + 1;
                return (
                  <li>
                    <a
                      href={url(`/routes/${service.slug}`)}
                      class="group flex items-center gap-4 rounded-xl border border-navy-100 bg-white p-5 transition-all duration-(--duration-base) hover:border-sea-300 hover:shadow-md"
                    >
                      <span
                        class="h-12 w-1.5 shrink-0 rounded-full"
                        style={`background-color:${service.mapColor}`}
                        aria-hidden="true"
                      />
                      <span class="min-w-0 flex-1">
                        <span class="block font-display text-base font-semibold text-navy-900 group-hover:text-sea-700">
                          {service.name}
                        </span>
                        <span class="mt-0.5 block text-sm text-navy-600">{service.coverage}</span>
                      </span>
                      <span class="shrink-0 text-right text-sm">
                        <span class="block text-xs uppercase tracking-wide text-navy-500">
                          Call
                        </span>
                        <span class="font-mono font-semibold text-navy-900">
                          {position} of {service.rotation.length}
                        </span>
                      </span>
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </section>

        <!-- Cargo handled -->
        <section aria-labelledby="cargo-heading" class="mt-12">
          <h2 id="cargo-heading" class="text-2xl">Cargo handled</h2>
          <dl class="mt-5 grid gap-4 sm:grid-cols-2">
            {
              port.capabilities.map((capability) => (
                <div class="rounded-xl border border-navy-100 p-4">
                  <dt class="font-display text-sm font-semibold text-navy-900">
                    {CAPABILITY_LABELS[capability]}
                  </dt>
                  <dd class="mt-1 text-sm leading-relaxed text-navy-600">
                    {CAPABILITY_DESCRIPTIONS[capability]}
                  </dd>
                </div>
              ))
            }
          </dl>
        </section>

        <!-- Direct connections -->
        {
          connectedPorts.size > 0 && (
            <section aria-labelledby="connections-heading" class="mt-12">
              <h2 id="connections-heading" class="text-2xl">
                Direct connections
              </h2>
              <p class="mt-2 text-navy-600">
                Ports reached immediately before or after {port.name} on a rotation.
              </p>
              <ul class="mt-5 flex flex-wrap gap-2">
                {[...connectedPorts.values()].map((connection) => (
                  <li>
                    <a
                      href={url(`/ports/${connection.slug}`)}
                      class="tap-target inline-flex flex-col justify-center rounded-lg border border-navy-200 px-4 py-1.5 transition-colors duration-(--duration-fast) hover:border-sea-400 hover:bg-sea-50"
                    >
                      <span class="text-sm font-medium text-navy-900">{connection.name}</span>
                      <span class="text-xs text-navy-500">via {connection.via.join(', ')}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>

      <!-- Sidebar -->
      <aside class="space-y-6 lg:sticky lg:top-28 lg:self-start">
        {
          port.agency && (
            <div class="rounded-2xl border border-navy-100 bg-navy-50/60 p-6">
              <h2 class="font-display text-base font-semibold text-navy-900">Local agency</h2>
              <dl class="mt-4 space-y-3 text-sm">
                <div>
                  <dt class="text-xs uppercase tracking-wide text-navy-500">Office</dt>
                  <dd class="mt-0.5 font-medium text-navy-900">{port.agency.officeName}</dd>
                </div>
                {port.agency.contactName && (
                  <div>
                    <dt class="text-xs uppercase tracking-wide text-navy-500">Contact</dt>
                    <dd class="mt-0.5 text-navy-800">{port.agency.contactName}</dd>
                  </div>
                )}
                <div>
                  <dt class="text-xs uppercase tracking-wide text-navy-500">E-mail</dt>
                  <dd class="mt-0.5">
                    <a
                      href={`mailto:${port.agency.email}`}
                      class="font-mono text-[0.8125rem] break-all text-sea-700 underline underline-offset-4 hover:text-sea-800"
                    >
                      {port.agency.email}
                    </a>
                  </dd>
                </div>
              </dl>
              <p class="mt-4 border-t border-navy-200 pt-3 text-xs leading-relaxed text-navy-500">
                Agency addresses follow the convention city.country@sdglines.com. They are part of
                the simulation and are not monitored mailboxes.
              </p>
            </div>
          )
        }

        <div class="rounded-2xl border border-navy-100 p-6">
          <h2 class="font-display text-base font-semibold text-navy-900">Next steps</h2>
          <ul class="mt-4 space-y-2">
            <li>
              <a
                href={url(`/quote?origin=${port.slug}`)}
                class="tap-target flex w-full items-center justify-center rounded-lg bg-signal-500 px-4 text-sm font-semibold text-navy-950 hover:bg-signal-400"
              >
                Quote from {port.name}
              </a>
            </li>
            <li>
              <a
                href={url(`/resources/arrival-charges?port=${port.slug}`)}
                class="tap-target flex w-full items-center justify-center rounded-lg border border-navy-200 px-4 text-sm font-semibold text-navy-800 hover:bg-navy-50"
              >
                Arrival charges here
              </a>
            </li>
            <li>
              <a
                href={url('/ports')}
                class="tap-target flex w-full items-center justify-center rounded-lg border border-navy-200 px-4 text-sm font-semibold text-navy-800 hover:bg-navy-50"
              >
                Back to the directory
              </a>
            </li>
          </ul>
        </div>

        <SimulationNotice variant="inline" />
      </aside>
    </div>
  </div>
</BaseLayout>
