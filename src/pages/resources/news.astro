---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import { updates, UPDATE_KIND_LABELS } from '@/data/updates';
import { url } from '@/lib/site';

/**
 * Updates to the simulation.
 *
 * A static page rather than one of the prose pages, because the content is
 * structured: each entry has a date, a kind, and - the part that actually
 * matters to a trainer - a note saying what to check in an exercise written
 * before it.
 *
 * Astro gives a static route priority over the dynamic `[slug].astro` in this
 * directory, so this file takes over /resources/news cleanly.
 */
const formatter = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

/** Tailwind cannot see a class name that is only assembled at runtime. */
const KIND_STYLES: Record<string, string> = {
  release: 'bg-signal-50 text-signal-900 border-signal-200',
  content: 'bg-sea-50 text-sea-900 border-sea-200',
  correction: 'bg-alert-50 text-alert-900 border-alert-200',
};

const latest = updates[0];
---

<BaseLayout
  title="Updates"
  description="Changes to the SDG Lines simulation and website, with a note on each telling trainers what to check in an exercise written before it."
>
  <PageHeader
    eyebrow="Resources"
    title="Updates"
    intro="What has changed in the simulation, and what to check in an exercise written before it."
    breadcrumbs={[{ label: 'Resources', href: '/resources' }, { label: 'Updates' }]}
  />

  <div class="shell py-12 lg:py-16">
    <div class="grid gap-12 lg:grid-cols-[1.7fr_1fr] lg:gap-14">
      <div class="min-w-0">
        <section aria-labelledby="purpose-heading">
          <h2 id="purpose-heading" class="text-2xl">What this page is for</h2>
          <p class="mt-4 leading-relaxed text-navy-700">
            A trainer who wrote an exercise six months ago needs to know whether the site still says
            what it said then. This page records changes to the simulation itself: routes, ports,
            vessels, equipment and charges.
          </p>
          <p class="mt-3 leading-relaxed text-navy-700">
            It is not a news feed about the shipping industry. The previous website carried three
            articles dated October 2020 under this heading, which by 2026 told a visitor mainly that
            nobody was maintaining it.
          </p>
        </section>

        <section aria-labelledby="updates-heading" class="mt-12">
          <h2 id="updates-heading" class="text-2xl">All updates</h2>

          <ol class="mt-6 space-y-4">
            {
              updates.map((update) => (
                <li>
                  <article class="rounded-2xl border border-navy-100 bg-white p-6 sm:p-7">
                    <div class="flex flex-wrap items-center gap-3">
                      <span
                        class={`rounded-full border px-2.5 py-0.5 text-xs font-semibold ${KIND_STYLES[update.kind]}`}
                      >
                        {UPDATE_KIND_LABELS[update.kind]}
                      </span>
                      <time datetime={update.date} class="font-mono text-xs text-navy-500">
                        {formatter.format(new Date(update.date))}
                      </time>
                    </div>

                    <h3 class="mt-3 font-display text-xl font-semibold text-navy-900">
                      {update.title}
                    </h3>
                    <p class="mt-2 leading-relaxed text-navy-700">{update.summary}</p>

                    {update.details && (
                      <ul class="mt-4 space-y-2 border-t border-navy-100 pt-4">
                        {update.details.map((detail) => (
                          <li class="flex gap-2.5 text-sm leading-relaxed text-navy-700">
                            <span
                              class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-sea-500"
                              aria-hidden="true"
                            />
                            <span>{detail}</span>
                          </li>
                        ))}
                      </ul>
                    )}

                    {update.actionForTrainers && (
                      <p class="mt-4 rounded-lg bg-navy-50 px-4 py-3 text-sm leading-relaxed text-navy-800">
                        <strong class="font-semibold">For trainers:</strong>{' '}
                        {update.actionForTrainers}
                      </p>
                    )}

                    {update.link && (
                      <a
                        href={url(update.link.href)}
                        class="mt-4 inline-flex text-sm font-semibold text-sea-700 hover:underline underline-offset-4"
                      >
                        {update.link.label} &rarr;
                      </a>
                    )}
                  </article>
                </li>
              ))
            }
          </ol>
        </section>
      </div>

      <aside class="space-y-6 lg:sticky lg:top-28 lg:self-start">
        <div class="rounded-2xl border border-navy-100 bg-navy-50/60 p-6">
          <h2 class="font-display text-base font-semibold text-navy-900">Most recent change</h2>
          <time datetime={latest.date} class="mt-2 block font-mono text-sm text-navy-600">
            {formatter.format(new Date(latest.date))}
          </time>
          <p class="mt-2 text-sm leading-relaxed text-navy-700">{latest.title}</p>
        </div>

        <div class="rounded-2xl border border-navy-100 p-6">
          <h2 class="font-display text-base font-semibold text-navy-900">Related</h2>
          <ul class="mt-3 space-y-1">
            {
              [
                { label: 'How content is reviewed', href: '/about/quality' },
                { label: 'Outstanding verification items', href: '/about/quality' },
                { label: 'All resources', href: '/resources' },
                { label: 'About SDG Lines', href: '/about' },
              ].map((link) => (
                <li>
                  <a
                    href={url(link.href)}
                    class="flex min-h-9 items-center text-sm text-navy-700 hover:text-sea-700 hover:underline underline-offset-4"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
