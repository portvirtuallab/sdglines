---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import NetworkChart from '@/components/map/NetworkChart.astro';
import { services } from '@/data/services';
import { getPortById, ports } from '@/data/ports';
import { url } from '@/lib/site';
import { CAPABILITY_LABELS, TO_BE_CONFIRMED } from '@/lib/labels';

/**
 * Routes index.
 *
 * The legacy site listed the five services in a hover menu and gave each of
 * them a page with a photograph and one generic paragraph. This page does the
 * job that menu was standing in for: it shows all five services side by side,
 * with their coverage, rotation length and deployment, so that a learner can
 * pick one without opening five tabs.
 */
const totalCalls = services.reduce((sum, service) => sum + service.rotation.length, 0);
---

<BaseLayout
  title="Routes"
  description="The five SDG Lines services: Westmed, Eastmed, Optimed, EurAsia and Gimnesias. Ports of call, vessels deployed and cargo accepted on each rotation."
>
  <PageHeader
    eyebrow="Network"
    title="Routes and services"
    intro={`Five services connect ${ports.length} ports of call across Europe, the Mediterranean, Africa, the Middle East and Asia, with ${totalCalls} calls in total.`}
    breadcrumbs={[{ label: 'Routes' }]}
  />

  <div class="shell py-12 lg:py-16">
    <!-- Network chart, with the full list underneath so nothing depends on it -->
    <section aria-labelledby="chart-heading" class="mb-14">
      <h2 id="chart-heading" class="sr-only">Chart of the network</h2>
      <div class="on-dark overflow-hidden rounded-2xl bg-navy-900 p-4 text-sea-200 sm:p-8">
        <NetworkChart
          bounds={[-19, 26, 42, 57]}
          showLabels={true}
          description="Chart of the SDG Lines network across Europe, the Mediterranean and North Africa. Each coloured line is one service and each point is a port of call. Ports served by more than one service are drawn with a ring. Every rotation is also listed as text below."
        />

        <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 border-t border-navy-700 pt-5">
          {
            services.map((service) => (
              <li class="flex items-center gap-2.5 text-sm text-white">
                <span
                  class="h-1 w-8 rounded-full"
                  style={`background-color:${service.mapColor}`}
                  aria-hidden="true"
                />
                {service.name}
              </li>
            ))
          }
        </ul>

        <p class="mt-4 text-xs leading-relaxed text-navy-300">
          The chart covers Europe, the Mediterranean and North Africa. The EurAsia service continues
          beyond these bounds to the Red Sea, the Arabian Gulf, India and Korea; those calls are
          listed in full on the EurAsia page.
        </p>
      </div>
    </section>

    <!-- Services, each with its complete rotation as an ordered list -->
    <section aria-labelledby="services-heading">
      <h2 id="services-heading" class="text-2xl sm:text-3xl">The five services</h2>

      <div class="mt-8 space-y-6">
        {
          services.map((service) => (
            <article class="overflow-hidden rounded-2xl border border-navy-100 bg-white">
              <div class="border-b border-navy-100 bg-navy-50/60 px-6 py-5 sm:px-8">
                <div class="flex flex-wrap items-start justify-between gap-4">
                  <div>
                    <div class="flex items-center gap-3">
                      <span
                        class="h-2.5 w-10 rounded-full"
                        style={`background-color:${service.mapColor}`}
                        aria-hidden="true"
                      />
                      <span class="font-mono text-xs font-medium tracking-wider text-navy-500">
                        {service.code}
                      </span>
                    </div>
                    <h3 class="mt-2 font-display text-2xl font-semibold text-navy-900">
                      <a
                        href={url(`/routes/${service.slug}`)}
                        class="hover:text-sea-700 hover:underline underline-offset-4"
                      >
                        {service.name}
                      </a>
                    </h3>
                    <p class="mt-1 text-sm font-medium text-navy-500">{service.coverage}</p>
                  </div>

                  <a
                    href={url(`/routes/${service.slug}`)}
                    class="tap-target inline-flex items-center rounded-lg bg-navy-900 px-4 text-sm font-semibold text-white hover:bg-navy-800"
                  >
                    Open {service.name}
                  </a>
                </div>

                <p class="mt-4 max-w-3xl leading-relaxed text-navy-700">{service.summary}</p>
              </div>

              <div class="grid gap-8 px-6 py-6 sm:px-8 lg:grid-cols-[2fr_1fr]">
                <div>
                  <h4 class="font-display text-sm font-semibold uppercase tracking-wide text-navy-500">
                    Rotation
                  </h4>
                  <ol class="mt-3 flex flex-wrap items-center gap-x-1.5 gap-y-2">
                    {service.rotation.map((call, index) => {
                      const port = getPortById(call.portId);
                      if (!port) return null;
                      return (
                        <li class="flex items-center gap-1.5">
                          <a
                            href={url(`/ports/${port.slug}`)}
                            class="rounded-md bg-navy-50 px-2.5 py-1 text-sm font-medium text-navy-800 transition-colors duration-(--duration-fast) hover:bg-sea-50 hover:text-sea-800"
                          >
                            <span class="font-mono text-[0.6875rem] text-navy-400">
                              {String(index + 1).padStart(2, '0')}
                            </span>{' '}
                            {port.name}
                          </a>
                          {index < service.rotation.length - 1 && (
                            <span class="text-navy-300" aria-hidden="true">
                              &rarr;
                            </span>
                          )}
                        </li>
                      );
                    })}
                  </ol>
                </div>

                <dl class="grid grid-cols-2 gap-4 text-sm lg:grid-cols-1">
                  <div>
                    <dt class="text-xs uppercase tracking-wide text-navy-500">Frequency</dt>
                    <dd class="mt-0.5 font-semibold text-navy-900">
                      {service.frequency ?? TO_BE_CONFIRMED}
                    </dd>
                  </div>
                  <div>
                    <dt class="text-xs uppercase tracking-wide text-navy-500">Vessels deployed</dt>
                    <dd class="mt-0.5 font-semibold text-navy-900">
                      {service.vesselIds.length > 0 ? service.vesselIds.length : TO_BE_CONFIRMED}
                    </dd>
                  </div>
                  <div class="col-span-2 lg:col-span-1">
                    <dt class="text-xs uppercase tracking-wide text-navy-500">Cargo accepted</dt>
                    <dd class="mt-1 flex flex-wrap gap-1.5">
                      {service.capabilities.map((capability) => (
                        <span class="rounded-full bg-sea-50 px-2.5 py-0.5 text-xs font-medium text-sea-800">
                          {CAPABILITY_LABELS[capability]}
                        </span>
                      ))}
                    </dd>
                  </div>
                </dl>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
