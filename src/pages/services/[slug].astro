---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import EquipmentTable from '@/components/ui/EquipmentTable.astro';
import SimulationNotice from '@/components/layout/SimulationNotice.astro';
import { cargoServices } from '@/data/cargoServices';
import { services as routes } from '@/data/services';
import { ports } from '@/data/ports';
import { equipment } from '@/data/equipment';
import { url } from '@/lib/site';

/** One page per cargo service. */
export function getStaticPaths() {
  return cargoServices.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

const acceptingRoutes = routes.filter((route) => route.capabilities.includes(service.capability));
const handlingPorts = ports.filter((port) => port.capabilities.includes(service.capability));
const relevantEquipment = service.equipmentSlugs
  .map((slug) => equipment.find((item) => item.slug === slug))
  .filter((item): item is NonNullable<typeof item> => Boolean(item));

const otherServices = cargoServices.filter((other) => other.slug !== service.slug);
---

<BaseLayout
  title={service.title}
  description={`${service.summary} Accepted on ${acceptingRoutes.map((r) => r.name).join(', ')} and handled at ${handlingPorts.length} SDG Lines ports.`}
>
  <PageHeader
    eyebrow="Cargo services"
    title={service.title}
    intro={service.summary}
    breadcrumbs={[{ label: 'Services', href: '/services' }, { label: service.title }]}
  />

  <div class="shell py-12 lg:py-16">
    <div class="grid gap-12 lg:grid-cols-[1.6fr_1fr] lg:gap-14">
      <div class="min-w-0">
        <section aria-labelledby="about-heading">
          <h2 id="about-heading" class="text-2xl">About this service</h2>
          <div class="mt-4 space-y-4 text-[1.0625rem] leading-relaxed text-navy-700">
            {service.description.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </section>

        <section aria-labelledby="guidance-heading" class="mt-12">
          <h2 id="guidance-heading" class="text-2xl">What to get right</h2>
          <div class="mt-5 space-y-4">
            {
              service.guidance.map((note) => (
                <div class="rounded-xl border border-navy-100 bg-white p-6">
                  <h3 class="font-display text-base font-semibold text-navy-900">{note.heading}</h3>
                  <p class="mt-2 leading-relaxed text-navy-700">{note.body}</p>
                </div>
              ))
            }
          </div>
        </section>

        {
          relevantEquipment.length > 0 && (
            <section aria-labelledby="equipment-heading" class="mt-12">
              <h2 id="equipment-heading" class="text-2xl">
                Equipment used
              </h2>
              <p class="mt-2 text-navy-600">
                The units most often chosen for this cargo. The full catalogue has the rest.
              </p>
              <div class="mt-5">
                <EquipmentTable
                  items={relevantEquipment}
                  caption={`Equipment commonly used for ${service.title.toLowerCase()}`}
                />
              </div>
              <a
                href={url('/equipment')}
                class="mt-4 inline-flex text-sm font-semibold text-sea-700 hover:underline underline-offset-4"
              >
                Full equipment catalogue &rarr;
              </a>
            </section>
          )
        }

        <section aria-labelledby="routes-heading" class="mt-12">
          <h2 id="routes-heading" class="text-2xl">Routes that accept this cargo</h2>

          {
            acceptingRoutes.length > 0 ? (
              <ul class="mt-5 space-y-3">
                {acceptingRoutes.map((route) => (
                  <li>
                    <a
                      href={url(`/routes/${route.slug}`)}
                      class="group flex items-center gap-4 rounded-xl border border-navy-100 bg-white p-5 transition-all duration-(--duration-base) hover:border-sea-300 hover:shadow-md"
                    >
                      <span
                        class="h-12 w-1.5 shrink-0 rounded-full"
                        style={`background-color:${route.mapColor}`}
                        aria-hidden="true"
                      />
                      <span class="min-w-0 flex-1">
                        <span class="block font-display text-base font-semibold text-navy-900 group-hover:text-sea-700">
                          {route.name}
                        </span>
                        <span class="mt-0.5 block text-sm text-navy-600">{route.coverage}</span>
                      </span>
                      <span class="shrink-0 text-sm text-navy-500">
                        {route.rotation.length} calls
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-4 rounded-xl border border-dashed border-navy-200 bg-navy-50/60 p-6 text-navy-700">
                No published route currently accepts this cargo type.
              </p>
            )
          }
        </section>

        <section aria-labelledby="ports-heading" class="mt-12">
          <h2 id="ports-heading" class="text-2xl">Ports that handle it</h2>
          <p class="mt-2 text-navy-600">
            {handlingPorts.length} of the {ports.length} ports in the network handle this cargo type.
          </p>
          <ul class="mt-5 flex flex-wrap gap-2">
            {
              handlingPorts.map((port) => (
                <li>
                  <a
                    href={url(`/ports/${port.slug}`)}
                    class="tap-target inline-flex items-center rounded-lg border border-navy-200 px-3.5 text-sm text-navy-800 transition-colors duration-(--duration-fast) hover:border-sea-400 hover:bg-sea-50"
                  >
                    {port.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      </div>

      <aside class="space-y-6 lg:sticky lg:top-28 lg:self-start">
        <div class="rounded-2xl border border-navy-100 bg-navy-50/60 p-6">
          <h2 class="font-display text-base font-semibold text-navy-900">Ship this cargo</h2>
          <ul class="mt-4 space-y-2">
            <li>
              <a
                href={url('/request-a-quote')}
                class="tap-target flex w-full items-center justify-center rounded-lg bg-signal-500 px-4 text-sm font-semibold text-navy-950 hover:bg-signal-400"
              >
                Request a quotation
              </a>
            </li>
            <li>
              <a
                href={url('/resources/arrival-charges')}
                class="tap-target flex w-full items-center justify-center rounded-lg border border-navy-200 bg-white px-4 text-sm font-semibold text-navy-800 hover:bg-white/60"
              >
                Charges for this cargo
              </a>
            </li>
          </ul>
        </div>

        <div class="rounded-2xl border border-navy-100 p-6">
          <h2 class="font-display text-base font-semibold text-navy-900">Other services</h2>
          <ul class="mt-3 space-y-1">
            {
              otherServices.map((other) => (
                <li>
                  <a
                    href={url(`/services/${other.slug}`)}
                    class="flex min-h-9 items-center text-sm text-navy-700 hover:text-sea-700 hover:underline underline-offset-4"
                  >
                    {other.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <SimulationNotice variant="inline" />
      </aside>
    </div>
  </div>
</BaseLayout>
