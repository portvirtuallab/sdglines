---
import type { ProseBlock } from '@/data/pages';
import { url } from '@/lib/site';

/**
 * Renders one block of a prose page.
 *
 * The block types are deliberately few. A content model with twenty block types
 * ends up with twenty inconsistent renderings; five cover everything these pages
 * need and keep the result visually coherent.
 */
interface Props {
  block: ProseBlock;
}

const { block } = Astro.props;
---

{block.type === 'paragraph' && <p class="leading-relaxed text-navy-700">{block.text}</p>}

{
  block.type === 'heading' && (
    <h3 class="mt-8 font-display text-xl font-semibold text-navy-900">{block.text}</h3>
  )
}

{
  block.type === 'list' && (
    <ul class="space-y-2">
      {block.items.map((item) => (
        <li class="flex gap-2.5 leading-relaxed text-navy-700">
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-sea-500" aria-hidden="true" />
          <span>{item}</span>
        </li>
      ))}
    </ul>
  )
}

{
  block.type === 'callout' && (
    <aside class="rounded-xl border border-sea-200 bg-sea-50/60 p-5">
      {block.heading && (
        <h3 class="font-display text-base font-semibold text-sea-900">{block.heading}</h3>
      )}
      <p class="mt-1.5 leading-relaxed text-navy-800">{block.text}</p>
    </aside>
  )
}

{
  block.type === 'definitions' && (
    <dl class="grid gap-px overflow-hidden rounded-xl border border-navy-100 bg-navy-100 sm:grid-cols-2">
      {block.items.map((item) => (
        <div class="bg-white px-5 py-4">
          <dt class="font-display text-sm font-semibold text-navy-900">{item.term}</dt>
          <dd class="mt-1 text-sm leading-relaxed text-navy-600">{item.definition}</dd>
        </div>
      ))}
    </dl>
  )
}

{
  block.type === 'links' && (
    <ul class="flex flex-wrap gap-2">
      {block.items.map((item) => (
        <li>
          <a
            href={item.external ? item.href : url(item.href)}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
            class="tap-target inline-flex items-center rounded-lg border border-navy-200 px-4 text-sm font-semibold text-navy-800 transition-colors duration-(--duration-fast) hover:border-sea-400 hover:bg-sea-50"
          >
            {item.label}
            {item.external && <span class="sr-only"> (opens in a new tab)</span>}
          </a>
        </li>
      ))}
    </ul>
  )
}
