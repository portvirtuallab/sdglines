---
import ProseSection from './ProseSection.astro';
import type { ProsePage } from '@/data/pages';

/**
 * Renders a prose page: its sections, plus a contents list that doubles as
 * in-page navigation on long pages.
 */
interface Props {
  page: ProsePage;
}

const { page } = Astro.props;
const showContents = page.sections.length > 2;
---

<div class="shell py-12 lg:py-16">
  <div class={showContents ? 'grid gap-12 lg:grid-cols-[1fr_16rem] lg:gap-14' : 'max-w-3xl'}>
    <div class="min-w-0 max-w-3xl">
      {
        page.sections.map((section) => (
          <section
            aria-labelledby={`${section.id}-heading`}
            class="mb-12 scroll-mt-28"
            id={section.id}
          >
            <h2 id={`${section.id}-heading`} class="text-2xl">
              {section.heading}
            </h2>
            <div class="mt-4 space-y-4">
              {section.blocks.map((block) => (
                <ProseSection block={block} />
              ))}
            </div>
          </section>
        ))
      }
    </div>

    {
      showContents && (
        <nav
          aria-labelledby="contents-heading"
          class="lg:sticky lg:top-28 lg:order-last lg:self-start"
        >
          <h2
            id="contents-heading"
            class="font-display text-xs font-semibold uppercase tracking-[0.12em] text-navy-500"
          >
            On this page
          </h2>
          <ul class="mt-3 space-y-1 border-l border-navy-100">
            {page.sections.map((section) => (
              <li>
                <a
                  href={`#${section.id}`}
                  class="-ml-px flex min-h-9 items-center border-l-2 border-transparent pl-4 text-sm text-navy-600 transition-colors duration-(--duration-fast) hover:border-sea-500 hover:text-sea-700"
                >
                  {section.heading}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</div>
