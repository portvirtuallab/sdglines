---
import { Image } from 'astro:assets';
import stacked from '@/assets/sdg-lines-logo.png';
import horizontal from '@/assets/sdg-lines-logo-horizontal.png';

/**
 * The SDG Lines logo.
 *
 * Both of these are the real brand artwork, taken from sdglines.com. Neither is
 * redrawn or recoloured.
 *
 * Two lockups, because they do different jobs:
 *
 *   - `horizontal` is the one with the "Shipping Digital Game" tagline. It is
 *     the right shape for a header: the stacked version is nearly square, so at
 *     a legible width it forced the header taller than it needed to be.
 *   - `stacked` is the square version, for places with height but not width.
 *
 * On a dark surface the mark's navy swoosh disappears, so `plate` sets the
 * artwork on a white panel rather than recolouring it.
 */
interface Props {
  /**
   * Accessible name. Set to the empty string when the logo sits inside a link
   * that already has visible text, to avoid announcing the destination twice.
   */
  alt?: string;
  /** Which lockup to use. */
  variant?: 'horizontal' | 'stacked';
  /** White backing panel, for use on the navy surfaces. */
  plate?: boolean;
  class?: string;
}

const {
  alt = 'SDG Lines, home',
  variant = 'horizontal',
  plate = false,
  class: className = '',
} = Astro.props;

const source = variant === 'horizontal' ? horizontal : stacked;
---

{
  plate ? (
    <span class={`inline-flex items-center justify-center rounded-xl bg-white p-3 ${className}`}>
      <Image src={source} alt={alt} class="h-full w-auto" densities={[1, 2]} loading="eager" />
    </span>
  ) : (
    <Image src={source} alt={alt} class={className} densities={[1, 2]} loading="eager" />
  )
}
