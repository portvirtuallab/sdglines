---
import { Image } from 'astro:assets';
import logo from '@/assets/sdg-lines-logo.png';

/**
 * The SDG Lines logo.
 *
 * This is the real brand artwork, not a redrawing. It is served through Astro's
 * image pipeline so that it is emitted at the sizes actually used and with
 * explicit dimensions, which keeps it out of the layout shift budget.
 *
 * One thing to know before using it on a dark surface: the mark contains a navy
 * swoosh (#203058) that disappears against the navy backgrounds used elsewhere
 * on this site. Rather than recolour the brand artwork, `plate` sets the logo on
 * a white panel, which is the conventional treatment and leaves the mark
 * untouched.
 */
interface Props {
  /**
   * Accessible name. Set to the empty string when the logo sits inside a link
   * that already has visible text, to avoid announcing the destination twice.
   */
  alt?: string;
  /** White backing panel, for use on the navy surfaces. */
  plate?: boolean;
  class?: string;
}

const { alt = 'SDG Lines, home', plate = false, class: className = '' } = Astro.props;
---

{
  plate ? (
    <span class={`inline-flex items-center justify-center rounded-xl bg-white p-2.5 ${className}`}>
      <Image src={logo} alt={alt} class="h-full w-auto" densities={[1, 2]} loading="eager" />
    </span>
  ) : (
    <Image src={logo} alt={alt} class={className} densities={[1, 2]} loading="eager" />
  )
}
