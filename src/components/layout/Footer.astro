---
import Logo from './Logo.astro';
import { FOOTER_NAV, SITE, url } from '@/lib/site';

const year = new Date().getFullYear();
---

<footer class="on-dark mt-24 bg-navy-900 text-navy-200">
  <div class="chart-grid">
    <div class="shell py-14 lg:py-16">
      <div class="grid gap-10 lg:grid-cols-[1.2fr_2.4fr]">
        <div>
          <Logo class="h-9 w-auto text-white" title="" />
          <p class="mt-4 max-w-xs text-sm leading-relaxed">
            The simulated shipping line of Port Virtual Lab, operated by {SITE.operator} for
            education and professional training.
          </p>

          <address class="mt-6 text-sm not-italic leading-relaxed">
            {SITE.address.street}<br />
            {SITE.address.postalCode}
            {SITE.address.city}, {SITE.address.country}<br />
            <a
              href={`mailto:${SITE.contactEmail}`}
              class="mt-1 inline-block text-white underline decoration-navy-500 underline-offset-4 hover:decoration-white"
            >
              {SITE.contactEmail}
            </a>
          </address>

          <a
            href={SITE.linkedIn}
            target="_blank"
            rel="noopener noreferrer"
            class="tap-target mt-5 inline-flex items-center gap-2 rounded-md text-sm font-medium text-white hover:underline"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M4.98 3.5a2.5 2.5 0 11.02 5 2.5 2.5 0 01-.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.76V21h-4v-5.6c0-1.34-.03-3.06-1.9-3.06-1.9 0-2.2 1.46-2.2 2.96V21H9z"
              ></path>
            </svg>
            Escola Europea on LinkedIn
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </div>

        <nav aria-label="Footer">
          <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
            {
              FOOTER_NAV.map((group) => (
                <div>
                  <h2 class="font-display text-xs font-semibold uppercase tracking-[0.12em] text-navy-400">
                    {group.heading}
                  </h2>
                  <ul class="mt-3 space-y-1">
                    {group.links.map((link) => (
                      <li>
                        <a
                          href={url(link.href)}
                          class="inline-flex min-h-9 items-center text-sm text-navy-200 transition-colors duration-(--duration-fast) hover:text-white hover:underline underline-offset-4"
                        >
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </nav>
      </div>

      <hr class="my-10 border-navy-800" />

      <div class="space-y-4 text-xs leading-relaxed text-navy-400">
        <p class="rounded-lg border border-navy-700 bg-navy-800/60 p-4 text-navy-100">
          <strong class="font-semibold text-white">{SITE.simulationNotice}</strong> Routes, vessels,
          ports, charges and quotations on this site exist for training exercises within Port
          Virtual Lab. Nothing here constitutes a commercial offer.
        </p>

        <p>
          Powered by Port Virtual Lab. &copy; {year} Escola Europea Short Sea Shipping, Spain. All rights
          reserved. Unauthorised use, reproduction or distribution is prohibited and may result in
          legal action.
        </p>

        <p>
          The Port Virtual Lab&#174; name and mark, along with SDG Lines&#174;, SDG
          Airlines&#174;, MEDtrade&#174; and Playforwarding&#174;, are owned by Escola Europea de
          Short Sea Shipping AEIE.
        </p>

        <p>
          This work by Escola Europea - Intermodal Transport is licensed under a
          <a
            href="https://creativecommons.org/licenses/by-nc-nd/4.0/"
            target="_blank"
            rel="noopener noreferrer license"
            class="text-navy-200 underline underline-offset-4 hover:text-white"
          >
            Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 International License<span
              class="sr-only">(opens in a new tab)</span
            >
          </a>.
        </p>

        <ul class="flex flex-wrap gap-x-5 gap-y-2 pt-2">
          <li>
            <a href={url('/legal')} class="hover:text-white hover:underline underline-offset-4"
              >Legal notice</a
            >
          </li>
          <li>
            <a href={url('/accessibility')} class="hover:text-white hover:underline underline-offset-4"
              >Accessibility statement</a
            >
          </li>
          <li>
            <a href={url('/privacy')} class="hover:text-white hover:underline underline-offset-4"
              >Privacy</a
            >
          </li>
          <li>
            <a href={url('/sitemap')} class="hover:text-white hover:underline underline-offset-4"
              >Sitemap</a
            >
          </li>
        </ul>
      </div>
    </div>
  </div>
</footer>
